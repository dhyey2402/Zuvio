# Application Setup
APP_NAME=Zuvio
APP_ENV=development
API_V1_STR=/api/v1

# Database Configuration
POSTGRES_SERVER=localhost
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_secure_password
POSTGRES_DB=zuvio
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_SERVER}:5432/${POSTGRES_DB}

# Security & Authentication
SECRET_KEY=generate_a_strong_random_secret_string_here
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Object Storage (Supabase / AWS S3)
STORAGE_BUCKET_NAME=zuvio-storage
STORAGE_ACCESS_KEY=your_access_key
STORAGE_SECRET_KEY=your_secret_key
STORAGE_REGION=us-east-1
STORAGE_ENDPOINT_URL=https://your-endpoint.com

# Google OAuth
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=https://zuvio.onrender.com/api/v1/auth/google/callback
